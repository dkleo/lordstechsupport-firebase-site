rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Contact submissions are written only by Admin SDK (Cloud Functions).
    // No public client read/write.
    match /contacts/{contactId} {
      allow read, write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
